# AresCraftX — Security Headers
# Для Netlify: положить в корень как _headers
# Для Cloudflare Pages: настроить в _headers файле
# Для Nginx: добавить в server block (см. ниже)
# Для Apache: добавить в .htaccess (см. ниже)

/config.json
  X-Robots-Tag: noindex, nofollow
  Allow: DENY

/database.sql
  X-Robots-Tag: noindex, nofollow
  Allow: DENY

# Служебные файлы репозитория — не должны попадать в поиск
/tools/*
  X-Robots-Tag: noindex, nofollow

/SECURITY.md
  X-Robots-Tag: noindex, nofollow

/LICENSE
  X-Robots-Tag: noindex, nofollow

/nginx-security.conf
  X-Robots-Tag: noindex, nofollow

# Закрытые разделы
/ru/auth/*
  X-Robots-Tag: noindex, nofollow

/en/auth/*
  X-Robots-Tag: noindex, nofollow

/ru/admin/*
  X-Robots-Tag: noindex, nofollow

/en/admin/*
  X-Robots-Tag: noindex, nofollow

/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  X-XSS-Protection: 1; mode=block
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=()
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net https://cdnjs.cloudflare.com https://api.qrserver.com https://static.cloudflareinsights.com; style-src 'self' 'unsafe-inline' https://cdnjs.cloudflare.com; img-src 'self' data: https://api.qrserver.com https://ggyaitqgukjgcjscvwjj.supabase.co; font-src 'self' data: https://cdnjs.cloudflare.com; connect-src 'self' https://ggyaitqgukjgcjscvwjj.supabase.co https://api.mcsrvstat.us https://api.emailjs.com https://cloudflareinsights.com; frame-ancestors 'none'; base-uri 'self'; form-action 'self'
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
