# Файлы, которые НЕ должны публиковаться как статические ассеты.
# Синтаксис как у .gitignore.
# Cloudflare Pages исключал часть из них автоматически,
# Workers Static Assets — не исключает, нужно перечислять явно.

# Конфигурация (работает, но не отдаётся наружу)
wrangler.jsonc
wrangler.toml
.assetsignore

# Служебное содержимое репозитория
.git
**/.git
**/.github
**/node_modules
**/.DS_Store
tools
